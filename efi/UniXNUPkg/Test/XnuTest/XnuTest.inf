[Defines]
  INF_VERSION    = 0x00010019
  BASE_NAME      = XnuTest
  FILE_GUID      = 90311252-9F79-46D5-83CA-42D6738A5D0C
  MODULE_TYPE    = UEFI_DRIVER
  VERSION_STRING = 0.1
  ENTRY_POINT    = XnuTestEntry

[Sources]
  XnuTest.c

[Packages]
  MdePkg/MdePkg.dec
  UniXNUPkg/UniXNUPkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  PrintLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint
  UefiLib

[Protocols]
  gUniXNULoaderProtocolGuid  ## PRODUCES
  gEfiLoadedImageProtocolGuid     ## CONSUMES
