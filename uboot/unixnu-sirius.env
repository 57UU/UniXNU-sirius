stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole
preboot=scsi scan; mmc rescan; usb start
fastboot=fastboot usb 0
kernel_addr_r=0x80080000
ramdisk_addr_r=0x83000000
fdt_addr_r=0x82a00000
scriptaddr=0x82800000

efi_args=setenv bootargs loglevel=3 root=/dev/mmcblk0p81 rootwait=15 rootfs_part=mmcblk0p81 sysmod_part=mmcblk0p79 persist_part=mmcblk0p68 rw consoleblank=120
efi_load=load mmc 0:4f ${kernel_addr_r} /boot/efi/BOOTAA64.EFI; setenv efi_size ${filesize}; load mmc 0:4f ${ramdisk_addr_r} /boot/initrd.cpio.gz; setenv ramdisk_size ${filesize}; load mmc 0:4f ${fdt_addr_r} /boot/dtb/sdm710-xiaomi-sirius.dtb
try_efi=run efi_args; run efi_load; bootefi ${kernel_addr_r}:${efi_size} ${ramdisk_addr_r}:${ramdisk_size} ${fdt_addr_r}

do_boot=run try_efi; sysboot mmc 0:4f any ${scriptaddr} /boot/extlinux/extlinux.conf; bootefi bootmgr

# UniXNU (Xnu4Sirius): the payload lives on the vendor partition (mmcblk0p80, FAT).
# unixnu_check makes it opt-in per boot: with the marker file /EFI/UniXNU/BOOTUNIXNU
# present on mmc 0:50 the next boot goes straight to UniXNU.efi; without it this
# U-Boot boots Linux as always. The bootmenu entry boots it on demand.
#
# unixnu_arm arms fastboot for the next power-on through the Android bootloader control
# block: "bootonce-bootloader" is the command stock ABL already understands (it is what
# "adb reboot bootloader" writes), so a hung UniXNU boot comes back to the primary
# bootloader's fastboot with a plain power cycle instead of the Vol-Down + Power chord.
# dialogue but drops the bulk-IN responses on this board, so the host hangs on a flash.
# U-Boot's fastboot answers getvar current-slot with "a", so the host appends _a to every
# partition name it flashes ("vendor_a"). Alias both spellings onto the real GPT names.
fastboot_partition_alias_vendor_a=vendor
fastboot_partition_alias_boot_a=boot
fastboot_partition_alias_userdata_a=userdata
# Arming fastboot for the next power-on was tried and is disabled: writing the BCB command
# "uboot-fastboot" works (check_bcb turns it into U-Boot's own fastboot on the next start), but
# that gadget cannot flash on this board (its bulk-IN replies are dropped), and the PMIC spare
# ABL actually reads (PON_SOFT_RB_SPARE = 0x88f in U-Boot's PID/offset encoding, value 0x04)
# needs CONFIG_CMD_PMIC and a verified pmic device name first. The Vol-Down + Power chord is
# still the way back until one of those is proven.
unixnu_arm=if bcb load 0 misc; then bcb set command uboot-fastboot; bcb store; fi
unixnu_boot=run unixnu_arm; load mmc 0:50 ${kernel_addr_r} /EFI/BOOT/BOOTAA64.EFI; bootefi ${kernel_addr_r}:${filesize}
unixnu_check=if load mmc 0:50 ${scriptaddr} /EFI/UniXNU/BOOTUNIXNU; then run unixnu_boot; fi

bootmenu_0=Boot first available device=run do_boot
bootmenu_1=Boot EFI (p79 BOOTAA64.EFI)=run try_efi
bootmenu_2=Boot UniXNU (p80 vendor)=run unixnu_boot
bootmenu_3=Enable fastboot mode=run fastboot
bootmenu_4=Reset device=reset
menucmd=bootmenu
check_bcb=bcb load 0 misc; if bcb test command ~ uboot-fastboot; then bcb clear command; bcb store; run fastboot; elif bcb test command ~ uboot-menu; then bcb clear command; bcb store; run menucmd; fi
bootcmd=run check_bcb; run unixnu_check; run do_boot
