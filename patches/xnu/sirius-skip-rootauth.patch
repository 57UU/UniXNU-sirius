+			 * observable; without the boot argument the kernel panics exactly as before. */
+			unsigned sirius_skip_rootauth = 0;
+			PE_parse_boot_argn("sirius-skip-rootauth", &sirius_skip_rootauth,
+			    sizeof(sirius_skip_rootauth));
+			if (autherr && !owner_authorized && sirius_skip_rootauth == 0) {
 				panic("rootvp not authenticated after mounting");
 			}
+			if (autherr && sirius_skip_rootauth != 0) {
+				printf("sirius: rootvp authentication answered %d, skipped by boot arg\n", autherr);
+			}
