# Kernel configuration of the sirius image. CONFIG_XNU_<NAME> becomes XNU_<NAME> for the kernel build.
#
# The first-console configuration: the generic parts of the fajita set. ArmDTPlatform (the
# device-tree platform expert) and ArmCpu (the CPU/GIC/timer driver) drive the board through
# the ADT of scripts/make-sirius-adt.py. No storage, display or PMGR components yet: XNU is
# expected to reach the video console and stop at the root device (or the AMFI No-PMGR panic).

CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
# The boot progress display (kits/sirius, Font.h vendored): draws the kernel console lines
# on the frame buffer in a readable font. This board overrides build-xnu-4k-baseline.sh to
# drop the UFS/owner-root requirement of the upstream interlock (eMMC board).
CONFIG_XNU_BOOT_PROGRESS=y
# The BCM2837 machine config hardcodes a Raspberry Pi panic-log address; with this flag the
# panic region comes from the device tree instead (absent here, which skips it safely).
CONFIG_XNU_DT_PANIC_REGION=y

CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
# The DEVELOPMENT kernel references native_legacy_display_probe() unconditionally
# (offline-component-load-probes.patch); the dormant stub archive of
# scripts/build-sirius-probes.py keeps the link closed (kits/sirius/LegacyDisplayProbe.cpp).
CONFIG_XNU_EXTRA_LD_ARCHIVES="-Wl,-force_load,{tree}/build/sirius-probes/libSiriusProbes.a"
CONFIG_XNU_NATIVE_UFS=n
CONFIG_XNU_NATIVE_AES=n
CONFIG_XNU_NATIVE_VIRTIO_BLOCK=n
CONFIG_XNU_NATIVE_RAM_BLOCK=n
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=n
CONFIG_XNU_ARMVIRT_PLATFORM=n
